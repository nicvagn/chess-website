{
  "compilerOptions": {
    "noImplicitAny": true,
    "alwaysStrict": true,
    "noUnusedParameters": true,
    "target": "ES6",
    "lib": [
      "dom",
      "ES6"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "explainFiles": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}